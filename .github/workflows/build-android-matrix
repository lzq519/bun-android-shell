# GitHub Workflow: 使用 NDK 交叉编译 Bun for Android
# 
# 此工作流程用于在 Android 设备（Termux/Shell）上构建可运行的 Bun JavaScript 运行时
# 支持的架构：aarch64 (arm64), x86_64
#
# 使用方法：
# 1. 手动触发：Workflows -> Build Bun for Android -> Run workflow
# 2. 标签触发：推送 bun-v* 标签时自动构建发布版本

name: Build Bun for Android

# 触发条件
on:
  # 手动触发
  workflow_dispatch:
    inputs:
      build_type:
        description: '构建类型'
        required: true
        default: 'release'
        type: choice
        options:
          - release
          - debug
      android_api:
        description: 'Android API 级别'
        required: true
        default: '24'
        type: choice
        options:
          - '21'
          - '23'
          - '24'
          - '28'
          - '29'
          - '30'
  
  # 自动触发：主分支推送时 / 标签推送时
  push:
    branches: [main, master]
    tags: ['bun-v*']

# 并发控制：取消同一分支/标签的旧构建
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# 环境变量
env:
  # 构建优化选项
  BUILD_OPTIMIZE: "ReleaseFast"
  # NDK 版本
  NDK_VERSION: "r26b"
  # 默认 Android API 级别
  DEFAULT_ANDROID_API: "24"

jobs:
  # ============================================
  # 构建作业：交叉编译 Bun
  # ============================================
  build:
    name: 构建 Bun (${{ matrix.target }})
    runs-on: ubuntu-22.04
    strategy:
      fail-fast: false
      matrix:
        include:
          # ARM64 (现代 Android 设备 - 主要目标)
          - target: aarch64-linux-android
            cpu: baseline
            ndk_arch: aarch64
            artifact_name: bun-android-arm64
            desc: "ARM64 (现代 Android 手机)"
            
          # x86_64 (模拟器/Chromebook)
          - target: x86_64-linux-android
            cpu: baseline
            ndk_arch: x86_64
            artifact_name: bun-android-x64
            desc: "x86_64 (Android 模拟器/Chromebook)"

    # 步骤超时
    timeout-minutes: 120

    steps:
      # ----------------------------------------
      # 步骤 1: 检出源码
      # ----------------------------------------
      - name: 检出源码
        uses: actions/checkout@v4
        with:
          # 递归克隆子模块 (Bun 依赖 WebKit 等子模块)
          submodules: recursive
          # 浅克隆以加快速度
          fetch-depth: 1

      # ----------------------------------------
      # 步骤 2: 确定 Zig 版本
      # ----------------------------------------
      - name: 确定 Zig 版本
        id: zig-version
        run: |
          # Bun 源码根目录通常有 .zig-version 文件
          if [ -f ".zig-version" ]; then
            ZIG_VERSION=$(cat .zig-version)
            echo "Zig 版本: $ZIG_VERSION"
            echo "version=$ZIG_VERSION" >> $GITHUB_OUTPUT
          else
            # 默认使用较新且稳定的版本
            echo "version=0.13.0" >> $GITHUB_OUTPUT
          fi

      # ----------------------------------------
      # 步骤 3: 安装系统依赖
      # ----------------------------------------
      - name: 安装系统依赖
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            cmake \
            ninja-build \
            build-essential \
            libxml2-dev \
            unzip \
            wget \
            curl

      # ----------------------------------------
      # 步骤 4: 设置 Android NDK
      # ----------------------------------------
      - name: 设置 Android NDK
        uses: android-actions/setup-ndk@v3
        id: setup-ndk
        with:
          ndk-version: ${{ env.NDK_VERSION }}

      # ----------------------------------------
      # 步骤 5: 设置 Zig 工具链
      # ----------------------------------------
      - name: 设置 Zig
        uses: mlugg/setup-zig@v1
        with:
          version: ${{ steps.zig-version.outputs.version }}

      # ----------------------------------------
      # 步骤 6: 配置交叉编译环境
      # ----------------------------------------
      - name: 配置交叉编译环境
        run: |
          # 导出 NDK 路径
          export ANDROID_NDK=${{ steps.setup-ndk.outputs.ndk-path }}
          export ANDROID_NDK_HOME=${{ steps.setup-ndk.outputs.ndk-path }}
          
          # 获取 NDK 工具链路径
          NDK_TOOLCHAIN=$ANDROID_NDK/toolchains/llvm/prebuilt/linux-x86_64
          
          echo "ANDROID_NDK=$ANDROID_NDK" >> $GITHUB_ENV
          echo "ANDROID_NDK_HOME=$ANDROID_NDK_HOME" >> $GITHUB_ENV
          echo "NDK_TOOLCHAIN=$NDK_TOOLCHAIN" >> $GITHUB_ENV
          
          # 设置目标 Android API 级别
          echo "ANDROID_PLATFORM=android-${{ github.event.inputs.android_api || env.DEFAULT_ANDROID_API }}" >> $GITHUB_ENV
          
          echo "=== 环境配置完成 ==="
          echo "NDK 路径: $ANDROID_NDK"
          echo "目标平台: android-${{ github.event.inputs.android_api || env.DEFAULT_ANDROID_API }}"
          echo "目标架构: ${{ matrix.target }}"

      # ----------------------------------------
      # 步骤 7: 构建 Bun
      # ----------------------------------------
      - name: 构建 Bun
        run: |
          # 导出环境变量
          export ANDROID_NDK=${{ steps.setup-ndk.outputs.ndk-path }}
          export ANDROID_NDK_HOME=${{ steps.setup-ndk.outputs.ndk-path }}
          
          # Android API 级别
          ANDROID_API=${{ github.event.inputs.android_api || env.DEFAULT_ANDROID_API }}
          
          echo "=== 开始构建 Bun ==="
          echo "目标: ${{ matrix.target }}"
          echo "优化级别: ${{ env.BUILD_OPTIMIZE }}"
          echo "CPU: ${{ matrix.cpu }}"
          
          # 使用 Zig 构建 Bun
          # 注意：实际构建参数可能需要根据 Bun 版本调整
          zig build \
            -Dtarget=${{ matrix.target }} \
            -Doptimize=${{ env.BUILD_OPTIMIZE }} \
            -Dcpu=${{ matrix.cpu }} \
            --summary all \
            2>&1 | tee build.log
          
          # 检查构建产物
          echo "=== 构建产物检查 ==="
          if [ -f "zig-out/bin/bun" ]; then
            file zig-out/bin/bun
            ls -lh zig-out/bin/bun
          else
            echo "警告: 未找到标准构建产物，检查其他位置..."
            find zig-out -name "bun" -type f -executable 2>/dev/null
          fi

      # ----------------------------------------
      # 步骤 8: 验证构建产物
      # ----------------------------------------
      - name: 验证构建产物
        run: |
          BUN_BINARY=""
          
          # 查找 Bun 二进制文件
          if [ -f "zig-out/bin/bun" ]; then
            BUN_BINARY="zig-out/bin/bun"
          elif [ -f "zig-out/bin/bun.exe" ]; then
            BUN_BINARY="zig-out/bin/bun.exe"
          else
            # 尝试查找
            BUN_BINARY=$(find zig-out -name "bun" -type f -executable 2>/dev/null | head -1)
          fi
          
          if [ -z "$BUN_BINARY" ]; then
            echo "错误: 找不到构建的 Bun 二进制文件"
            exit 1
          fi
          
          echo "找到 Bun 二进制: $BUN_BINARY"
          
          # 检查文件类型
          echo "=== 文件信息 ==="
          file "$BUN_BINARY"
          
          # 检查是否为正确的架构
          BINARY_INFO=$(file "$BUN_BINARY")
          if echo "$BINARY_INFO" | grep -q "${{ matrix.ndk_arch }}"; then
            echo "✓ 架构验证通过"
          else
            echo "警告: 架构可能不匹配"
          fi
          
          # 显示文件大小
          echo "=== 文件大小 ==="
          ls -lh "$BUN_BINARY"

      # ----------------------------------------
      # 步骤 9: 精简二进制 (strip)
      # ----------------------------------------
      - name: 精简二进制
        run: |
          BUN_BINARY=$(find zig-out -name "bun" -type f -executable 2>/dev/null | head -1)
          
          if [ -z "$BUN_BINARY" ]; then
            echo "错误: 找不到 Bun 二进制文件"
            exit 1
          fi
          
          # 使用 NDK 提供的 llvm-strip 去除调试符号
          NDK_TOOLCHAIN=${{ env.NDK_TOOLCHAIN }}
          STRIP_TOOL="$NDK_TOOLCHAIN/bin/llvm-strip"
          
          if [ -f "$STRIP_TOOL" ]; then
            echo "使用 llvm-strip 精简二进制..."
            "$STRIP_TOOL" "$BUN_BINARY"
            echo "精简后大小:"
            ls -lh "$BUN_BINARY"
          else
            echo "警告: 未找到 llvm-strip，跳过精简步骤"
          fi

      # ----------------------------------------
      # 步骤 10: 打包构建产物
      # ----------------------------------------
      - name: 打包构建产物
        run: |
          BUN_BINARY=$(find zig-out -name "bun" -type f -executable 2>/dev/null | head -1)
          
          if [ -z "$BUN_BINARY" ]; then
            echo "错误: 找不到 Bun 二进制文件"
            exit 1
          fi
          
          # 创建打包目录
          mkdir -p dist
          
          # 复制并重命名二进制文件
          cp "$BUN_BINARY" dist/bun-${{ matrix.artifact_name }}
          
          # 添加执行权限
          chmod +x dist/bun-${{ matrix.artifact_name }}
          
          # 创建 tar.gz 压缩包
          tar -czvf dist/bun-${{ matrix.artifact_name }}.tar.gz -C dist bun-${{ matrix.artifact_name }}
          
          echo "=== 打包完成 ==="
          ls -lh dist/

      # ----------------------------------------
      # 步骤 11: 上传构建产物
      # ----------------------------------------
      - name: 上传构建产物
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.artifact_name }}
          path: |
            dist/bun-${{ matrix.artifact_name }}.tar.gz
            dist/bun-${{ matrix.artifact_name }}
          retention-days: 30

  # ============================================
  # 发布作业：创建 GitHub Release
  # ============================================
  release:
    needs: build
    if: startsWith(github.ref, 'refs/tags/')
    permissions:
      contents: write
    runs-on: ubuntu-22.04
    steps:
      # ----------------------------------------
      # 步骤 1: 下载所有构建产物
      # ----------------------------------------
      - name: 下载所有构建产物
        uses: actions/download-artifact@v4
        with:
          path: artifacts

      # ----------------------------------------
      # 步骤 2: 列出下载的文件
      # ----------------------------------------
      - name: 列出构建产物
        run: |
          echo "=== 已下载的构建产物 ==="
          find artifacts -type f -name "*.tar.gz" -o -name "bun-android*" | head -20

      # ----------------------------------------
      # 步骤 3: 创建 GitHub Release
      # ----------------------------------------
      - name: 创建 GitHub Release
        uses: softprops/action-gh-release@v1
        with:
          # 生成发布说明
          body: |
            ## Bun Android 构建产物

            此版本包含针对 Android 平台的预编译 Bun 二进制文件。

            ### 支持的架构

            - **ARM64 (aarch64)**: 现代 Android 设备 (推荐)
            - **x86_64**: Android 模拟器、Chromebook

            ### 安装说明 (Termux)

            ```bash
            # 下载并解压
            tar -xzf bun-android-arm64.tar.gz
            
            # 移动到 PATH
            mv bun-android-arm64 $PREFIX/bin/bun
            
            # 测试运行
            bun --version
            ```

            ### 构建信息

            - 构建时间: ${{ github.run_timestamp }}
            - Git SHA: ${{ github.sha }}
            - NDK 版本: ${{ env.NDK_VERSION }}

            **注意**: 此构建可能不包含 JIT 编译支持，因为在某些 Android 设备上可能存在兼容性问题。
          # 文件模式
          files: |
            **/bun-android-*.tar.gz
          # 是否设为预发布
          prerelease: ${{ !startsWith(github.ref, 'refs/tags/v1.0') }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # ============================================
  # 总结作业：显示构建状态
  # ============================================
  summary:
    needs: build
    if: always()
    runs-on: ubuntu-22.04
    steps:
      - name: 构建总结
        run: |
          echo "## Bun Android 构建总结" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          
          # 检查构建结果
          if [ "${{ needs.build.result }}" == "success" ]; then
            echo "✅ 构建成功" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "### 构建产物" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "| 架构 | 状态 |" >> $GITHUB_STEP_SUMMARY
            echo "|-----|------|" >> $GITHUB_STEP_SUMMARY
            echo "| ARM64 (Android) | ✅ 成功 |" >> $GITHUB_STEP_SUMMARY
            echo "| x86_64 (Android) | ✅ 成功 |" >> $GITHUB_STEP_SUMMARY
          else
            echo "❌ 构建失败" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "请检查构建日志以获取详细信息。" >> $GITHUB_STEP_SUMMARY
          fi
